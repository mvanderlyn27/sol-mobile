{
  "name": "slice-of-life",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_ENV=development expo start",
    "start:test": "dotenv -c test -- expo start",
    "start:prod": "NODE_ENV=production expo start",
    "run-dev:ios": "NODE_ENV=development expo run:ios",
    "run-test:ios": "dotenv -c test -- expo run:ios",
    "run-dev:android": "NODE_ENV=development expo run:android",
    "run-test:android": "dotenv -c test -- expo run:android",
    "build-ios-local:dev": "dotenv -c development -- eas build --platform ios --profile development --local",
    "build-ios-local:test": "dotenv -c test -- eas build --platform ios --profile preview --local",
    "build-ios-local:prod": "dotenv -c production -- eas build --platform ios --profile production --local",
    "build-android-local:dev": "dotenv -c development -- eas build --platform android --profile development --local",
    "build-android-local:test": "dotenv -c test -- eas build --platform android --profile preview --local",
    "build-android-local:prod": "dotenv -c production -- eas build --platform android --profile production --local",
    "build-android-local-apk:prod": "dotenv -c production -- eas build --platform android --profile production-apk --local",
    "build-ios-eas": "dotenv -c production -- eas build --platform ios --profile production",
    "build-android-eas": "dotenv -c production -- eas build --platform android --profile production",
    "submit-ios": "dotenv -c production -- eas submit --platform ios",
    "submit-android": "dotenv -c production -- eas submit --platform android",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "genUsers": "npx tsx genUsers.ts",
    "fixProdData": "dotenv -c production -- npx tsx transformPageAndReactions.ts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@legendapp/state": "^3.0.0-beta.19",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-assets/slider": "^9.1.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-masked-view/masked-view": "0.3.1",
    "@react-navigation/native": "^6.1.18",
    "@rneui/themed": "^4.0.0-rc.8",
    "@shopify/flash-list": "1.6.4",
    "@snaplet/copycat": "^5.1.0",
    "@supabase/supabase-js": "^2.46.2",
    "@types/lodash": "^4.17.13",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.1.0",
    "eas": "^0.1.0",
    "eas-cli": "^14.2.0",
    "expo": "~51.0.39",
    "expo-apple-authentication": "~6.4.2",
    "expo-auth-session": "^5.5.2",
    "expo-blur": "~13.0.2",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image": "~1.13.0",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.0.7",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "^3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-updates": "~0.25.27",
    "expo-web-browser": "~13.0.3",
    "lodash": "^4.17.21",
    "moti": "^0.29.0",
    "nativewind": "^2.0.11",
    "posthog-react-native": "^3.4.0",
    "posthog-react-native-session-replay": "0.1.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-animated-bottom-drawer": "^0.0.23",
    "react-native-blurhash": "^2.1.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "6.3.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "reanimated-color-picker": "^3.0.6",
    "tinycolor2": "^1.6.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "^18.3.0",
    "@types/tinycolor2": "^1.4.6",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "postgres": "^3.4.5",
    "react-test-renderer": "18.2.0",
    "supabase": "^1.223.10",
    "tailwindcss": "3.3.2",
    "typescript": "~5.3.3"
  },
  "private": true
}
